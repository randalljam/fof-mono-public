---
import SiteLayout from '../../components/SiteLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<SiteLayout title="Reset password — Focus on Foundations">
  <Header />
  <main class="auth-page">
    <div class="container">
      <div class="auth-card">
        <h1>Reset your password</h1>
        <form class="auth-form" id="forgot-form" novalidate>
          <div class="form-field">
            <label for="forgot-email">Email</label>
            <input id="forgot-email" type="email" autocomplete="email" required />
          </div>
          <div id="reset-step" hidden>
            <div class="form-field">
              <label for="reset-code">Code from your email</label>
              <input id="reset-code" type="text" inputmode="numeric" autocomplete="one-time-code" />
            </div>
            <div class="form-field">
              <label for="reset-password">New password</label>
              <input id="reset-password" type="password" autocomplete="new-password" minlength="8" />
              <small>At least 8 characters with an uppercase letter, a lowercase letter, and a number.</small>
            </div>
          </div>
          <button class="primary-button" type="submit" id="forgot-submit">Email me a reset code</button>
        </form>
        <p class="auth-status" id="auth-status" role="status"></p>
        <p class="auth-links">
          <a href="/account/sign-in/">Back to sign in</a>
        </p>
      </div>
    </div>
  </main>
  <Footer />
</SiteLayout>

<script>
  import { completePasswordReset, requestPasswordReset } from '../../lib/auth.js';

  const statusEl = document.getElementById('auth-status');
  function showStatus(message, isError = false) {
    statusEl.textContent = message;
    statusEl.classList.toggle('is-error', isError);
  }
  let awaitingReset = false;
  document.getElementById('forgot-form').addEventListener('submit', async (event) => {
    event.preventDefault();
    const email = document.getElementById('forgot-email').value.trim();
    if (!email) return;
    try {
      if (!awaitingReset) {
        showStatus('Sending reset code…');
        await requestPasswordReset(email);
        awaitingReset = true;
        document.getElementById('reset-step').hidden = false;
        document.getElementById('forgot-submit').textContent = 'Set new password';
        document.getElementById('forgot-email').readOnly = true;
        showStatus('Code sent — check your email.');
      } else {
        const code = document.getElementById('reset-code').value.trim();
        const newPassword = document.getElementById('reset-password').value;
        if (!code || !newPassword) return;
        showStatus('Updating password…');
        await completePasswordReset(email, code, newPassword);
        showStatus('Password updated — sign in with it now.');
        setTimeout(() => { window.location.href = '/account/sign-in/'; }, 1200);
      }
    } catch (error) {
      showStatus(error.message || 'Password reset failed.', true);
    }
  });
</script>
