---
import { getItemRedirectsForPrefix } from '../../lib/legacy-redirects.js';

export function getStaticPaths() {
  return getItemRedirectsForPrefix('/sovereign-child-index').map(({ slug, target }) => ({
    params: { slug },
    props: { target },
  }));
}

const { target } = Astro.props;
return Astro.redirect(target, 301);
---
