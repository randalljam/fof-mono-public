---
import SiteLayout from '../components/SiteLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { loadLegalMarkdown } from '../lib/legal-content.js';

const html = loadLegalMarkdown('web-shared/web_docs/2024-12-17_privacy-policy.md');
---
<SiteLayout title="Privacy Policy — Focus on Foundations">
  <Header />
  <main class="legal-page">
    <div class="container">
      <h1>Privacy Policy</h1>
      <p class="lead">Last updated: 2024-12-17</p>
      <article class="legal-content" set:html={html} />
    </div>
  </main>
  <Footer />
</SiteLayout>
