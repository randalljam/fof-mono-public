{
  "name": "fof-site-infra",
  "version": "1.0.0",
  "private": true,
  "bin": {
    "fof-site": "bin/fof-site.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "synth": "npm run build && cdk synth",
    "deploy:staging": "npm run build && cdk deploy FofSiteStaging --require-approval never",
    "deploy:production": "npm run build && cdk deploy FofSiteProduction --require-approval never",
    "diff:staging": "npm run build && cdk diff FofSiteStaging",
    "diff:production": "npm run build && cdk diff FofSiteProduction",
    "test": "npm run build && node --test test/*.test.js"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1090.0",
    "@aws-sdk/client-dynamodb": "^3.1090.0",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/client-sesv2": "^3.1090.0",
    "@aws-sdk/lib-dynamodb": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@types/node": "^20.14.0",
    "aws-cdk": "^2.150.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.150.0",
    "constructs": "^10.3.0"
  }
}
