# ============================================================
# Off-limits directories (see AGENTS.md "Directory guide")
# ------------------------------------------------------------
# These were tracked historically but should never have been --
# experiments, model weights, ad hoc scratch, and old code.
# Untracked on 2026-05-25 in the pare-down pass; files remain on
# disk locally until uploaded to S3 / discarded.
# ============================================================
_misc_to_be_sorted/
limbo/
ms-graphrag/
lancedb/
pretrained_models/


# ============================================================
# AWS Chalice build artifacts
# ------------------------------------------------------------
# langchain-layer is a built Lambda layer (~141 MB, 4000 files);
# rebuild from requirements, do not commit.
# Rules are anchored at any depth so Chalice apps relocated under
# apps/<owning-app>/api/<lambda>/ keep their build artifacts ignored.
# ============================================================
web-shared/aws_chalice/langchain-layer/
**/langchain-layer/
**/.chalice/deployed/
**/.chalice/deployments/
**/vendor/
**/layer.zip


# ============================================================
# Local / generated / scratch directories (per file-types policy)
# ============================================================
data_local/
.data/
artifacts/
outputs/
generated/
runs/
tmp/
temp/
cache/
# voice app: generated/captured artifacts kept local, not tracked
# (mp3/wav are already covered globally below; these catch the frame PNGs
# and any non-audio generated output under the kokoro audio dir)
apps/voice/captured_frames/
apps/voice/kokoro/kokoro_audio/
# S3-backed asset directories from kid-games (uploaded to [S3-FILES-BUCKET], gitignored locally)
apps/games/poly-files/
apps/games/arnis-tile-cache/
# Third-party Minecraft mod JARs (large, downloadable)
apps/minecraft/skyblock/skyhanni/*.jar


# ============================================================
# Raw media -- store in S3, not git
# ============================================================
*.mp3
# Exception: math-quiz UI sound effects (58KB total, needed at runtime)
!apps/math-quiz/sounds/*.mp3
# FoF applet TTS clips: S3-backed (manifests/focusonfoundations_applet-audio.manifest.jsonl)
apps/focusonfoundations/web/public/audio/
# math-quiz: session data under apps/math-quiz/_data/ (see **_data** rule above)
*.wav
# Exception: robopoli UI sound effects (184KB total, needed at runtime)
!apps/games/robopoli/sounds/*.wav
*.m4a
*.flac
*.aac
*.ogg
*.mp4
*.mov
*.avi
*.mkv


# ============================================================
# Large binary document formats -- prefer S3
# (allowed via explicit ! exception if a small canonical fixture)
# ============================================================
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.doc
*.docx
*.ppt
*.pptx
*.xls
*.xlsx
*.pdf


# ============================================================
# Generated transcript pipeline outputs
# ------------------------------------------------------------
# Raw Deepgram responses + transcription dumps are large and
# regenerable. Small samples allowed under data/samples/.
# ============================================================
*.deepgram.json
*.transcription.raw.json
**/_zip_*.zip


